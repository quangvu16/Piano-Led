<?xml version="1.0" encoding="utf-8"?>
<!-- Practice screen, landscape: wider keyboard on the left, controls in a rail on the right.
     Generated layout; edit together with layout/activity_player.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_back"
            app:tint="@color/text_hi" />
        <TextView
            android:id="@+id/txtSongTitle"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_hi"
            android:textSize="17sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTimeNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_mid"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="@color/surface_2"
                android:progressTint="@color/text_hi"
                android:thumbTint="@color/text_hi" />

            <TextView
                android:id="@+id/txtTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_mid"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnOptions"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/opt_title"
            android:scaleType="center"
            android:src="@drawable/ic_sliders"
            app:tint="@color/text_hi" />
        <LinearLayout
            android:id="@+id/ledChip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_off"
            android:clickable="true"
            android:contentDescription="@string/cd_led"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:id="@+id/ledChipDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_off" />

            <TextView
                android:id="@+id/txtLedChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/lb_led_off_short"
                android:textColor="@color/text_mid"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <com.ledpiano.app.ui.LoopRangeBar
        android:id="@+id/loopBar"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginHorizontal="8dp"
        android:contentDescription="@string/cd_loop_range"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.ledpiano.app.ui.StaffView
        android:id="@+id/staff"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:visibility="gone" />

            <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.ledpiano.app.ui.PianoRollView
            android:id="@+id/pianoRoll"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/txtMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip_off"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/text_hi"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip_off"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/text_hi"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:textColor="@color/text_hi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnShowControls"
            android:layout_width="44dp"
            android:layout_height="64dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_chip_off"
            android:contentDescription="@string/cd_show_controls"
            android:rotation="180"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_back"
            android:visibility="gone"
            app:tint="@color/text_hi" />
    </FrameLayout>

            <com.ledpiano.app.ui.KeyboardView
                android:id="@+id/keyboard"
                android:layout_width="match_parent"
                android:layout_height="112dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controlsPanel"
            android:layout_width="204dp"
            android:layout_height="match_parent"
            android:background="@color/surface_1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/player_hands"
                android:textColor="@color/text_mid"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <LinearLayout
                    android:id="@+id/btnHandLeft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_left" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:duplicateParentState="true"
                        android:maxLines="1"
                        android:text="@string/bt_left_short"
                        android:textColor="@color/seg_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnHandBoth"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_both" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:duplicateParentState="true"
                        android:maxLines="1"
                        android:text="@string/bt_both_hands"
                        android:textColor="@color/seg_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnHandRight"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_right" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:duplicateParentState="true"
                        android:maxLines="1"
                        android:text="@string/bt_right_short"
                        android:textColor="@color/seg_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="@string/lb_speed"
                android:textColor="@color/text_mid"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnSpeedDown"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:clickable="true"
                    android:contentDescription="@string/cd_slower"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/seg_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSpeed"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.4"
                    android:gravity="center"
                    android:text="100%"
                    android:textColor="@color/text_hi"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSpeedUp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:clickable="true"
                    android:contentDescription="@string/cd_faster"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/seg_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnRestart"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@string/bt_restart"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_restart"
                    app:tint="@color/text_hi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bt_restart"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_circle_light"
                    android:contentDescription="@string/lb_play"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@color/ink" />

                <TextView
                    android:id="@+id/txtPlayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/lb_play"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_toggle"
                    android:contentDescription="@string/bt_repeat"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/toggle_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bt_repeat"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnHotSpot"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_circle_dark"
                    android:clickable="true"
                    android:contentDescription="@string/cd_hot_spot"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/bt_hot_spot"
                    android:textColor="@color/text_hi"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_circle_dark"
                    android:clickable="true"
                    android:contentDescription="@string/cd_record"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/bt_record"
                    android:textColor="@color/text_hi"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

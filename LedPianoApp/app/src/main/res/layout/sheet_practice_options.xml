<?xml version="1.0" encoding="utf-8"?>
<!-- Practice options bottom sheet (PlayerActivity › Tùy chọn). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_title"
            android:textColor="@color/text_hi"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_instrument"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstrument"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="18dp"
            android:textAllCaps="false"
            android:textColor="@color/text_hi"
            android:textSize="15sp"
            app:backgroundTint="@color/surface_2"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_mode"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/optModeNormal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_mode_normal"
                android:textColor="@color/seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optModeWait"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_mode_wait"
                android:textColor="@color/seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optModeStep"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_mode_step"
                android:textColor="@color/seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_mid"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_lights"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/optLightsFull"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_lights_full"
                android:textColor="@color/seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optLightsFade"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_lights_fade"
                android:textColor="@color/seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optLightsOff"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_lights_off"
                android:textColor="@color/seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtLightsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_mid"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_labels"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/optLabelNone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_label_none"
                android:textColor="@color/seg_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optLabelC"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_label_c"
                android:textColor="@color/seg_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optLabelLetters"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_label_letters"
                android:textColor="@color/seg_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/optLabelSolfege"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/opt_label_solfege"
                android:textColor="@color/seg_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_more"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Switch
            android:id="@+id/swCountIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_count_in"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <Switch
            android:id="@+id/swMetronome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_metronome"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <Switch
            android:id="@+id/swAutoSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_auto_speed"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <Switch
            android:id="@+id/swStaff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_staff"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <Switch
            android:id="@+id/swFingers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_fingers"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <LinearLayout
            android:id="@+id/splitRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/opt_split"
                android:textColor="@color/text_hi"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/splitDown"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/text_hi"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splitValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_hi"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splitUp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/text_hi"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_led"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Switch
            android:id="@+id/swLedFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_led_feedback"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <Switch
            android:id="@+id/swLedPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_led_preview"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <Switch
            android:id="@+id/swLedDynamics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_led_dynamics"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendEsp32"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/opt_send_esp32"
            android:textAllCaps="false"
            android:textColor="@color/text_hi"
            app:backgroundTint="@color/surface_2"
            app:cornerRadius="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/opt_input"
            android:textColor="@color/text_mid"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInputStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/opt_input_hint"
            android:textColor="@color/text_mid"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBleMidi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/opt_ble_midi"
            android:textAllCaps="false"
            android:textColor="@color/text_hi"
            app:backgroundTint="@color/surface_2"
            app:cornerRadius="24dp" />

        <Switch
            android:id="@+id/swMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/opt_mic"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
